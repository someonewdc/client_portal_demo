{
  "name": "@client-portal/nestjs-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "files": [
    "dist",
    "README.md",
    "!dist/.tsbuildinfo"
  ],
  "exports": {
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "import": "./dist/bootstrap.js"
    },
    "./logging": {
      "types": "./dist/logging.d.ts",
      "import": "./dist/logging.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js"
    },
    "./problem-details": {
      "types": "./dist/problem-details.d.ts",
      "import": "./dist/problem-details.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run"
  },
  "dependencies": {
    "@client-portal/platform-core": "workspace:*",
    "@fastify/helmet": "13.1.0",
    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "fastify": "^5.0.0",
    "reflect-metadata": "^0.1.12 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "devDependencies": {
    "@client-portal/tsconfig": "workspace:*",
    "@nestjs/common": "11.1.29",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-fastify": "11.1.29",
    "@nestjs/swagger": "11.4.6",
    "@types/node": "24.13.3",
    "fastify": "5.11.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
