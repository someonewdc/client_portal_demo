{
  "name": "@client-portal/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ./openapi.json -o ./src/schema.d.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "build": "tsc --noEmit --incremental false",
    "test": "vitest run"
  },
  "dependencies": {
    "@client-portal/openapi-client-core": "workspace:*"
  },
  "devDependencies": {
    "@client-portal/tsconfig": "workspace:*",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
