{
  "name": "@client-portal/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "pnpm dlx openapi-typescript@7.13.0 ./openapi.json -o ./src/schema.d.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "build": "tsc --noEmit --incremental false"
  },
  "devDependencies": {
    "@client-portal/tsconfig": "workspace:*",
    "typescript": "5.9.3"
  }
}
