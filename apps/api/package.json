{
  "name": "@client-portal/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "prebuild": "pnpm --workspace-root build:core",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm --workspace-root build:core && pnpm db:generate",
    "typecheck": "tsc --noEmit --incremental false",
    "pretest": "pnpm --workspace-root build:core && pnpm db:generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@client-portal/nestjs-core": "workspace:*",
    "@client-portal/platform-core": "workspace:*",
    "@nestjs/common": "11.1.29",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-fastify": "11.1.29",
    "@nestjs/swagger": "11.4.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "fastify": "5.11.0",
    "nestjs-pino": "4.6.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@client-portal/tsconfig": "workspace:*",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
